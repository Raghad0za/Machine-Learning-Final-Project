{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd frontend && npm install",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "excludeFiles": "{frontend/**,notebooks/**,models/*.joblib,data/saudi_*.csv,data/translations.csv,data/coffee_enriched.csv,data/eval_queries.csv,data/profiles.json,data/blind_*.csv,try_recommender.py}"
    }
  },
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/index" }]
}
